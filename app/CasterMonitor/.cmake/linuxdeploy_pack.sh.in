#!/bin/sh 
# linux的打包脚本
#放置到build目录下

#传递参数
#QT的路径
QT_SDK_DIR="@QT_SDK_DIR@"
#图标的路径
ICON_FILE="@APP_ICON@"
#工程的路径
CMAKE_SOURCE_DIR="@CMAKE_SOURCE_DIR@"
#要打包的程序路径
DEPLOY_TARGET="@DEPLOY_TARGET@"

EXTRA_DIR="@EXTRA_DIR@"

DIST_PATH="@DIST_PATH@"

SYSTEM_PLATFORM="@SYSTEM_PLATFORM@"

# 根据平台选择路径
if [ "$SYSTEM_PLATFORM" = "LINUX_X64_PLATFORM" ]; then
    LINUXDEPLOY=${CMAKE_SOURCE_DIR}/env/pack/x86_64/linuxdeploy-x86_64.AppImage
    LINUXDEPLOY_QT_PLUGIN=${CMAKE_SOURCE_DIR}/env/pack/x86_64/linuxdeploy-plugin-qt-x86_64.AppImage
    APPIMAGE_TOOL=${CMAKE_SOURCE_DIR}/env/pack/x86_64/appimagetool-x86_64.AppImage
    APPIMAGE_RUNTIME=${CMAKE_SOURCE_DIR}/env/pack/x86_64/runtime-x86_64
elif [ "$SYSTEM_PLATFORM" = "LINUX_ARM_PLATFORM" ]; then
    LINUXDEPLOY=${CMAKE_SOURCE_DIR}/env/pack/aarch64/linuxdeploy-aarch64.AppImage
    LINUXDEPLOY_QT_PLUGIN=${CMAKE_SOURCE_DIR}/env/pack/aarch64/linuxdeploy-plugin-qt-aarch64.AppImage
    APPIMAGE_TOOL=${CMAKE_SOURCE_DIR}/env/pack/aarch64/appimagetool-aarch64.AppImage
    APPIMAGE_RUNTIME=${CMAKE_SOURCE_DIR}/env/pack/aarch64/runtime-aarch64
    OPENGL_SO=${CMAKE_SOURCE_DIR}/env/pack/aarch64/libOpenGL.so.0
else
    echo "未知平台：$PLATFORM"
    exit 1
fi


export QT_DIR=${QT_SDK_DIR}
export PATH=${QT_DIR}/bin:$PATH
export LIB_PATH=${QT_DIR}/lib:$LIB_PATH
export PLUGIN_PATH=${QT_DIR}/plugins:$PLUGIN_PATH
export QML2_PATH=${QT_DIR}/qml:$QML2_PATH
export LD_LIBRARY_PATH=${QT_DIR}/lib:$LD_LIBRARY_PATH 
export QT_PLUGIN_PATH=${QT_DIR}/plugins:$PLUGIN_PATH 

#设置工程的环境变量
export QML_SOURCES_PATHS=${CMAKE_SOURCE_DIR}


echo "-------------------- Para  -------------------------------"
echo ""
echo "[INFO] Qt SDK Path         : $QT_SDK_DIR"
echo "[INFO] Source Dir          : $CMAKE_SOURCE_DIR"
echo "[INFO] Deploy Target       : $DEPLOY_TARGET"
echo "[INFO] Dist Path           : $DIST_PATH"
echo "[INFO] Icon Path           : $ICON_FILE"
echo ""
echo "------------------LinuxDeploy PATH-------------------------"
echo ""
echo "[INFO] LinuxDeploy         : $LINUXDEPLOY"
echo "[INFO] Qt Plugin           : $LINUXDEPLOY_QT_PLUGIN"
echo ""
echo "------------------AppImageTool PATH-------------------------"
echo ""
echo "[INFO] AppImageTool         : $APPIMAGE_TOOL"
echo "[INFO] AppImage-Runtime     : $APPIMAGE_RUNTIME"
echo ""
echo "------------------ QT SDk PATH ----------------------------"
echo ""
echo "[INFO] LIB_PATH            : $LIB_PATH"
echo "[INFO] PLUGIN_PATH         : $PLUGIN_PATH"
echo "[INFO] QML2_PATH           : $QML2_PATH"
echo "[INFO] LD_LIBRARY_PATH     : $LD_LIBRARY_PATH"
echo "[INFO] QT_PLUGIN_PATH      : $QT_PLUGIN_PATH"
echo "[INFO] QML_SOURCES_PATHS   : $QML_SOURCES_PATHS"
echo "[INFO] PATH                : $PATH"
echo ""
#传递Qt的路径


#传递程序的路径
echo "------------------ Run Linux Deploy -----------------------"
echo ""
DEPLOY_ICON="$DEPLOY_TARGET.svg"
cp -vf $ICON_FILE $DEPLOY_ICON

rm -rf $DIST_PATH/*

#run 
$LINUXDEPLOY --plugin qt  --create-desktop-file --icon-file=$DEPLOY_ICON --executable=$DEPLOY_TARGET  --appdir $DIST_PATH

echo ""

echo "------------------ Copy Extra Source -----------------------"
cp -vf $QT_DIR/plugins/platformthemes/*.so $DIST_PATH/usr/plugins/platformthemes 
# 遍历并拷贝所有子目录（不包含文件）
for dir in "$EXTRA_DIR"/*/; do
  cp -r "$dir" "$DIST_PATH/usr/bin"
done

cp -vf $QT_DIR/libexec/QtWebEngineProcess "$DIST_PATH/usr/bin"

cp -vf -r $QT_DIR/resources $DIST_PATH/usr/resources

$LINUXDEPLOY --plugin qt --deploy-deps-only=$DIST_PATH/usr/bin/QtWebEngineProcess --appdir $DIST_PATH

echo ""

echo "------------------ Run AppImage Tool -----------------------"
# cp -vf $APPIMAGE_RUNTIME $DIST_PATH

# 根据平台选择路径
if [ "$SYSTEM_PLATFORM" = "LINUX_X64_PLATFORM" ]; then
	$APPIMAGE_TOOL $DIST_PATH --runtime-file $APPIMAGE_RUNTIME
elif [ "$SYSTEM_PLATFORM" = "LINUX_ARM_PLATFORM" ]; then
    cp $OPENGL_SO $DIST_PATH/usr/lib
    echo 'export QMLSCENE_DEVICE=softwarecontext' >> $DIST_PATH/AppRun
    echo 'export LIBGL_ALWAYS_INDIRECT=y' >> $DIST_PATH/AppRun
	$APPIMAGE_TOOL $DIST_PATH
else
    echo "未知平台：$PLATFORM"
    exit 1
fi


echo ""

echo "------------------ Deploy Finished! -----------------------"

# Run Env

#export QMLSCENE_DEVICE=softwarecontext
#export LIBGL_ALWAYS_INDIRECT=y