# Runtime image for NavCaster, based on Ubuntu 24.04.
#
# This Dockerfile expects a pre-built NavCaster package directory to be
# available at the build context. By default it consumes the layout produced
# by deploy/scripts/package_linux.sh:
#
#   dist/<package-name>/
#       bin/navcaster-admin
#       bin/navcaster-agent
#       bin/navcaster-caster
#       web/
#       scripts/
#       app/admin/migrations/
#       app/agent/config.example.json
#       env/redis/redis.config
#
# Usage:
#   deploy/scripts/build_runtime_image.sh
#
# The build script produces an immutable tag such as
# navcaster:team-dev-<short12> and writes OCI provenance labels.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG BASE_IMAGE=ubuntu:24.04
ARG VCS_REF=unknown
ARG VERSION=local
ARG SOURCE=https://github.com/NavTool/NavCaster
ARG CREATED=unknown

LABEL org.opencontainers.image.title="NavCaster runtime" \
      org.opencontainers.image.description="NavCaster v2 app-layout runtime image" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        libssl3 \
        libstdc++6 \
        libgcc-s1 \
        libatomic1 \
        curl; \
    ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime; \
    rm -rf /var/lib/apt/lists/*

# PACKAGE_DIR is the path on the host (relative to docker build context)
# that contains the NavCaster package layout to ship inside the image.
ARG PACKAGE_DIR=dist/NavCaster-local

# Default Redis connection for navcaster-caster inside the container.
# Override via build arg if needed.
ARG REDIS_HOST=redis
ARG REDIS_INTERNAL_PORT=6379

WORKDIR /app
COPY ${PACKAGE_DIR}/ /app/

# Make all binaries executable; some may have been copied from a Windows host.
RUN set -eux; \
    for f in /app/bin/* /app/env/redis/redis-* ; do \
        [ -f "$f" ] && chmod +x "$f" || true; \
    done; \
    mkdir -p /app/logs

EXPOSE 4202 8080
VOLUME ["/app/logs"]

CMD ["/app/bin/navcaster-caster", "--listen-host", "0.0.0.0", "--listen-port", "4202", "--health-host", "0.0.0.0", "--health-port", "8080", "--redis-host", "redis", "--redis-port", "6379"]
