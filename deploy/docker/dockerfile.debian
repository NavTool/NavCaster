# Build image for Debian/Ubuntu based distributions.
# Used by GitHub Actions to compile NavCaster inside a clean container that
# matches the target runtime. Ubuntu 20.04 ships a CMake package older than
# NavCaster's 3.21 minimum, so this image installs a pinned official CMake
# binary release.
ARG BASE_IMAGE=ubuntu:24.04
ARG CMAKE_VERSION=3.29.8
ARG NODE_VERSION=20.19.5
FROM ${BASE_IMAGE}

ARG CMAKE_VERSION=3.29.8
ARG NODE_VERSION=20.19.5

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# Make APT non-interactive and resilient against transient mirror failures.
RUN set -eux; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        gcc g++ make ninja-build \
        git curl wget xz-utils pkg-config \
        tzdata \
        libssl-dev \
        zlib1g-dev; \
    arch="$(uname -m)"; \
    case "${arch}" in \
        x86_64) cmake_arch="x86_64"; node_arch="x64" ;; \
        aarch64) cmake_arch="aarch64"; node_arch="arm64" ;; \
        *) echo "unsupported CMake binary architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    wget -q "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-${cmake_arch}.sh" \
        -O /tmp/cmake-install.sh; \
    sh /tmp/cmake-install.sh --skip-license --prefix=/usr/local; \
    rm -f /tmp/cmake-install.sh; \
    wget -q "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
        -O /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime; \
    dpkg-reconfigure -f noninteractive tzdata || true; \
    cmake --version; \
    ninja --version; \
    node --version; \
    npm --version; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]
