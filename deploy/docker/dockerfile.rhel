# Build image for RHEL/openEuler/Rocky/Alma based distributions.
ARG BASE_IMAGE=openeuler/openeuler:22.03
FROM ${BASE_IMAGE}

ENV TZ=Asia/Shanghai

RUN set -eux; \
    (dnf install -y dnf-plugins-core || true); \
    dnf install -y \
        gcc gcc-c++ make cmake ninja-build \
        git curl wget pkgconfig tar which \
        ca-certificates tzdata \
        openssl-devel zlib-devel; \
    ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime || true; \
    dnf clean all

WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]
