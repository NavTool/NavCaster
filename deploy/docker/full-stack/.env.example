COMPOSE_PROJECT_NAME=navcaster
NAVCASTER_VERSION=local

# Change every value marked change-me before exposing the stack.
POSTGRES_DB=navcaster
POSTGRES_USER=navcaster
POSTGRES_PASSWORD=change-me-postgres
NAVCASTER_ADMIN_BOOTSTRAP_TOKEN=change-me-bootstrap-token
NAVCASTER_ADMIN_DEV_ADMIN_USERNAME=admin
NAVCASTER_ADMIN_DEV_ADMIN_PASSWORD=change-me-admin-password

WEB_PORT=8080
ADMIN_PORT=18080
POSTGRES_PORT=15432
REDIS_PORT=16379

AGENT_1_ID=ag-compose-1
AGENT_1_HOST_ID=host-compose-agent-1
AGENT_1_CASTER_NTRIP_PORT=4202
AGENT_1_CASTER_HEALTH_PORT=14202
AGENT_1_WORKER_COUNT=4

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:8.6.3
NGINX_IMAGE=nginx:1.27-alpine
NAVCASTER_APP_IMAGE=navcaster/full-stack-app:local
NAVCASTER_WEB_IMAGE=navcaster/full-stack-web:local
