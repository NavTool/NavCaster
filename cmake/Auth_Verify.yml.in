# Auth_Verify 配置文件 
# 适用版本：@PROJECT_VERSION@


# 注册相关配置

Base_Setting:
  Anonymous_Login: true     #匿名登录模式
  Online_Protection: true   #在线登录保护（true：不允许挤掉当前账号  false：允许挤掉当前账号）
Rover_Setting:
  Anonymous_Login: true     #匿名登录模式
  Online_Protection: true   #在线登录保护（true：不允许挤掉当前账号  false：允许挤掉当前账号）
Source_Setting:
  Anonymous_Login: true     #匿名登录模式


# Redis连接
Reids_Connect_Setting:
  IP: 127.0.0.1               #如果是docker-compse启动  IP直接设置为redis
  Port: 16379
  Requirepass: password